func (composition *floretComposition) recoverBeforeReady(ctx context.Context, catalog floretRootCatalog, reconciler floretPendingToolReconciler) error {
	if catalog == nil {
		return errors.New("production-recovery requires a root catalog")
	}
	roots, err := catalog.ListFloretRootThreadIDs(ctx)
	if err != nil {
		return fmt.Errorf("list Floret roots: %w", err)
	}
	sort.Slice(roots, func(left, right int) bool { return roots[left] < roots[right] })
	parents := make(map[floretruntime.ThreadID]floretruntime.ThreadID, len(roots))
	queue := make([]floretRecoveryNode, 0, len(roots))
	for _, root := range roots {
		if strings.TrimSpace(string(root)) == "" {
			return errors.New("production root catalog contains an empty thread id")
		}
		if _, exists := parents[root]; exists {
			return fmt.Errorf("production root catalog repeats thread %q", root)
		}
		if len(parents) >= floretRecoveryMaxNodes {
			return &FloretRecoveryTraversalLimitError{Kind: "node", Limit: floretRecoveryMaxNodes, ThreadID: root}
		}
		parents[root] = ""
		if err := composition.recoverRoot(ctx, root); err != nil {
			return err
		}
		reader, err := composition.bindThreadReader(ctx, root)
		if err != nil {
			return err
		}
			targets, err := reader.ListPendingToolSettlementTargets(ctx, root)
			if err != nil {
				return err
			}
			if err := composition.settlePending(ctx, "", targets, reconciler); err != nil {
			return err
		}
		queue = append(queue, floretRecoveryNode{threadID: root})
	}
	for len(queue) > 0 {
		node := queue[0]
		queue = queue[1:]
		if node.depth >= floretRecoveryMaxDepth {
			return &FloretRecoveryTraversalLimitError{Kind: "depth", Limit: floretRecoveryMaxDepth, ThreadID: node.threadID}
		}
		reader, err := composition.subAgentRead.NewHost(ctx, node.threadID)
		if err != nil {
			return err
		}
		children, err := reader.ListSubAgents(ctx, node.threadID)
		if err != nil {
			return err
		}
		sort.Slice(children, func(left, right int) bool { return children[left].ThreadID < children[right].ThreadID })
		for _, child := range children {
			if child.ParentThreadID != node.threadID || strings.TrimSpace(string(child.ThreadID)) == "" || child.ThreadID == node.threadID {
				return fmt.Errorf("corrupt SubAgent authority under parent %q", node.threadID)
			}
			if previous, exists := parents[child.ThreadID]; exists {
				return fmt.Errorf("SubAgent %q appears under parents %q and %q", child.ThreadID, previous, node.threadID)
			}
			if len(parents) >= floretRecoveryMaxNodes {
				return &FloretRecoveryTraversalLimitError{Kind: "node", Limit: floretRecoveryMaxNodes, ThreadID: child.ThreadID}
			}
			parents[child.ThreadID] = node.threadID
			if err := composition.recoverChild(ctx, child); err != nil {
				return err
			}
			targets, err := reader.ListPendingToolSettlementTargets(ctx, floretruntime.ListSubAgentPendingToolSettlementTargetsRequest{
				ParentThreadID: node.threadID, ChildThreadID: child.ThreadID,
			})
			if err != nil {
				return err
			}
			if err := composition.settlePending(ctx, node.threadID, targets, reconciler); err != nil {
				return err
			}
			queue = append(queue, floretRecoveryNode{parentThreadID: node.threadID, threadID: child.ThreadID, depth: node.depth + 1})
		}
	}
	return nil
}

func (composition *floretComposition) recoverRoot(ctx context.Context, threadID floretruntime.ThreadID) error {
	reader, err := composition.bindThreadReader(ctx, threadID)
	if err != nil {
		return err
	}
	overview, err := reader.ReadThreadOverview(ctx, threadID)
	if err != nil {
		return err
	}
	switch overview.Thread.Status {
	case floretruntime.ThreadStatusInterrupted:
		factory, err := composition.interrupted.BindThread(ctx, threadID)
		if err != nil {
			return err
		}
		host, err := factory.NewHost(ctx, nil)
		if err != nil {
			return err
		}
		_, err = host.RecoverInterruptedTurn(ctx)
		return err
	case floretruntime.ThreadStatusRunning:
		return fmt.Errorf("root %q still has an active owner", threadID)
	case floretruntime.ThreadStatusIdle, floretruntime.ThreadStatusWaiting, floretruntime.ThreadStatusCompleted,
		floretruntime.ThreadStatusFailed, floretruntime.ThreadStatusCancelled:
		return nil
	default:
		return fmt.Errorf("root %q has unsupported startup status %q", threadID, overview.Thread.Status)
	}
}

func (composition *floretComposition) recoverChild(ctx context.Context, child floretruntime.SubAgentSnapshot) error {
	switch child.Status {
	case floretruntime.SubAgentStatusInterrupted:
		factory, err := composition.interrupted.BindSubAgent(ctx, child.ParentThreadID, child.ThreadID)
		if err != nil {
			return err
		}
		host, err := factory.NewHost(ctx, nil)
		if err != nil {
			return err
		}
		_, err = host.RecoverInterruptedTurn(ctx)
		return err
	case floretruntime.SubAgentStatusRunning, floretruntime.SubAgentStatusClosing:
		return fmt.Errorf("SubAgent %q still has an active owner", child.ThreadID)
	case floretruntime.SubAgentStatusIdle, floretruntime.SubAgentStatusWaiting, floretruntime.SubAgentStatusCompleted,
		floretruntime.SubAgentStatusFailed, floretruntime.SubAgentStatusCancelled, floretruntime.SubAgentStatusClosed:
		return nil
	default:
		return fmt.Errorf("SubAgent %q has unsupported startup status %q", child.ThreadID, child.Status)
	}
}

func (composition *floretComposition) settlePending(ctx context.Context, parentThreadID floretruntime.ThreadID, targets []floretruntime.PendingToolSettlementTarget, reconciler floretPendingToolReconciler) error {
	for _, target := range targets {
		if reconciler == nil {
			return fmt.Errorf("pending tool %q requires host reconciliation", target.ToolCallID)
		}
		request, ready, err := reconciler.ReconcileFloretPendingTool(ctx, parentThreadID, target)
		if err != nil {
			return err
		}
		if !ready {
			return fmt.Errorf("pending tool %q is not reconciled", target.ToolCallID)
		}
		if request.Target != target {
			return fmt.Errorf("pending tool reconciler changed target %q", target.ToolCallID)
		}
		var host *floretruntime.PendingToolRecoveryHost
		if parentThreadID == "" {
			host, err = composition.pending.NewThreadHost(ctx, target.ThreadID, nil)
		} else {
			host, err = composition.pending.NewSubAgentHost(ctx, parentThreadID, nil)
		}
		if err != nil {
			return err
		}
		if _, err := host.SettlePendingTool(ctx, request); err != nil {
			return err
		}
	}
	return nil
}
