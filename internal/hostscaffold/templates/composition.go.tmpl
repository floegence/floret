func (composition *floretComposition) blockInterruptedRoots(ctx context.Context, catalog floretRootCatalog) error {
	if catalog == nil {
		return errors.New("durable-basic requires a root catalog")
	}
	roots, err := catalog.ListFloretRoots(ctx)
	if err != nil {
		return fmt.Errorf("list Floret roots: %w", err)
	}
	sort.Slice(roots, func(left, right int) bool { return roots[left].ThreadID < roots[right].ThreadID })
	seen := make(map[floretruntime.ThreadID]struct{}, len(roots))
	targets := make([]FloretRecoveryRequiredTarget, 0)
	for _, root := range roots {
		if strings.TrimSpace(string(root.ThreadID)) == "" {
			return errors.New("durable-basic root catalog contains an empty thread id")
		}
		if _, exists := seen[root.ThreadID]; exists {
			return fmt.Errorf("durable-basic root catalog repeats thread %q", root.ThreadID)
		}
		seen[root.ThreadID] = struct{}{}
		if root.Profile != "durable-basic" || root.SubAgentsEnabled {
			return fmt.Errorf("durable-basic cannot prove root %q has no SubAgent authority", root.ThreadID)
		}
		reader, err := composition.bindThreadReader(ctx, root.ThreadID)
		if err != nil {
			return err
		}
		overview, err := reader.ReadThreadOverview(ctx, root.ThreadID)
		if err != nil {
			return err
		}
		if overview.Thread.Status == floretruntime.ThreadStatusRunning {
			return fmt.Errorf("durable-basic root %q still has an active owner", root.ThreadID)
		}
		if overview.Thread.Status == floretruntime.ThreadStatusInterrupted {
			if overview.Thread.LatestTurnID == "" || overview.Thread.LatestRunID == "" {
				return fmt.Errorf("durable-basic interrupted root %q has incomplete turn authority", root.ThreadID)
			}
			targets = append(targets, FloretRecoveryRequiredTarget{
				ThreadID: root.ThreadID,
				TurnID: overview.Thread.LatestTurnID,
				RunID: overview.Thread.LatestRunID,
			})
		}
	}
	if len(targets) == 0 {
		return nil
	}
	owned := append([]FloretRecoveryRequiredTarget(nil), targets...)
	return &FloretRecoveryRequiredError{Targets: owned}
}
{{- end }}
